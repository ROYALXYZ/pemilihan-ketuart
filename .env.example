# Salin berkas ini menjadi `.env` di samping docker-compose.yml,
# lalu sesuaikan nilainya. Jangan commit berkas `.env` yang sebenarnya.

# PIN login operator TPS (WAJIB diganti sebelum pemilihan).
ADMIN_PIN=123456

# Kunci tanda tangan cookie sesi. Isi dengan teks acak panjang agar sesi operator
# tidak ter-logout setiap kontainer di-restart. Contoh membuat:
#   openssl rand -hex 32
SESSION_SECRET=

# Zona waktu untuk tampilan jam di server dan log.
TZ=Asia/Jakarta
